{
  "name": "lininstall",
  "productName": "LinInstall",
  "version": "2.0.0",
  "description": "Linux system utility with GPU driver manager, app installer and tweaks",
  "main": "main.js",
  "author": {
    "name": "NoCapScripts",
    "email": "nocapscripts@gmail.com"
  },
  "homepage": "https://example.com/lininstall",
  "license": "MIT",
  "keywords": [
    "linux",
    "utility",
    "nvidia",
    "drivers",
    "fedora",
    "electron"
  ],
  "scripts": {
    "build:css": "tailwindcss -i ./src/input.css -o ./assets/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./src/input.css -o ./assets/tailwind.css --watch",
    "start": "npm run build:css && electron .",
    "dist": "npm run build:css && electron-builder --linux",
    "dist:appimage": "npm run build:css && electron-builder --linux AppImage",
    "dist:rpm": "npm run build:css && electron-builder --linux rpm",
    "dist:deb": "npm run build:css && electron-builder --linux deb"
  },
  "build": {
    "appId": "com.nocapscripts.lininstall",
    "productName": "LinInstall",
    "copyright": "Copyright © 2026 NoCapScripts",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "detect.js",
      "tasks.js",
      "index.html",
      "renderer.js",
      "assets/tailwind.css",
      "package.json",
      "build/icon.png"
    ],
    "artifactName": "${name}-${version}.${ext}",
    "linux": {
      "target": [
        "AppImage",
        "rpm",
        "deb"
      ],
      "category": "System",
      "icon": "build/icons",
      "maintainer": "NoCapScripts <nocapscripts@gmail.com>",
      "vendor": "NoCapScripts",
      "synopsis": "Linux utility and GPU driver manager",
      "description": "Install apps, update the system, manage NVIDIA/AMD/Intel GPU drivers and apply tweaks from one place.",
      "desktop": {
        "entry": {
          "Name": "LinInstall",
          "Comment": "System utility and GPU driver manager",
          "Keywords": "linux;utility;nvidia;drivers;system;",
          "StartupWMClass": "lininstall"
        }
      }
    },
    "rpm": {
      "depends": [
        "polkit",
        "pciutils"
      ],
      "fpm": [
        "--rpm-rpmbuild-define=_build_id_links none",
        "--rpm-rpmbuild-define=__os_install_post %{nil}"
      ]
    },
    "deb": {
      "depends": [
        "policykit-1",
        "pciutils"
      ]
    },
    "appImage": {
      "artifactName": "${name}-${version}.AppImage"
    }
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "tailwindcss": "^3.4.17"
  }
}