{
  "name": "lininstall",
  "productName": "LinInstall",
  "version": "3.0.0",
  "private": true,
  "description": "Linux system utility with GPU driver manager, app installer and tweaks (Tauri + Rust + Tailwind).",
  "author": "NoCapScripts <nocapscripts@gmail.com>",
  "license": "MIT",
  "scripts": {
    "build:css": "tailwindcss -i ./styles/input.css -o ./src/assets/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./styles/input.css -o ./src/assets/tailwind.css --watch=always",
    "tauri": "tauri",
    "dev": "tauri dev",
    "build": "tauri build",
    "build:rpm": "tauri build --bundles rpm",
    "build:deb": "tauri build --bundles deb",
    "build:appimage": "tauri build --bundles appimage"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "tailwindcss": "^3.4.17"
  }
}
