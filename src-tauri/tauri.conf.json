{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LinInstall",
  "version": "3.0.0",
  "identifier": "com.nocapscripts.lininstall",
  "build": {
    "frontendDist": "../src",
    "beforeDevCommand": "npm run watch:css",
    "beforeBuildCommand": "npm run build:css"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "LinInstall",
        "width": 1180,
        "height": 760,
        "minWidth": 640,
        "minHeight": 480,
        "backgroundColor": "#0e1014"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage"],
    "category": "Utility",
    "publisher": "NoCapScripts",
    "copyright": "Copyright © 2026 NoCapScripts",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "shortDescription": "Linux utility and GPU driver manager",
    "longDescription": "Install apps, update the system, manage NVIDIA/AMD/Intel GPU drivers and apply tweaks from one place.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "linux": {
      "deb": { "depends": ["policykit-1", "pciutils"] },
      "rpm": { "depends": ["polkit", "pciutils"] }
    }
  }
}
